# ── Supabase ─────────────────────────────────────────────
# Project Settings → API. Only the public anon/publishable key is needed —
# admin permissions are enforced by Row Level Security, not a secret key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# or: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Site ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://agix.ae

# ── Hero video (optional) ────────────────────────────────
NEXT_PUBLIC_HERO_VIDEO_URL=
